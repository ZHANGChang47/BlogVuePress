
//导入选项卡默认主题
@require '~vuepress-plugin-tabs/dist/themes/default.styl'


//修改右侧目录背景颜色
.right-menu-wrapper .right-menu-content .right-menu-item.active a {
    color: #3eaf7c;
    opacity: 1;
    background: #dbf0e5;
}

/* ============================================================
   站点样式重整 2026-11-12
   1. 收敛设计令牌：浅/深/阅读三套共用一套强调色与边框
   2. 导航栏重排：宽屏 flex 布局，窄屏收进抽屉（配合 enhanceApp.js）
   3. 卡片轻量化：去掉浮起阴影，改为细描边 + 统一圆角
   4. 克制动效：进入淡入、交错出现、悬停反馈，尊重 reduced-motion
   主色沿用原有绿系，未擅自更换配色。
   ============================================================ */

/* ---------- 1. 设计令牌 ---------- */
.theme-mode-light {
  --bodyBg: #f8f9f8;
  --mainBg: #ffffff;
  --borderColor: rgba(0, 0, 0, .10);
  --wbAccent: #3eaf7c;
  --wbAccentSoft: rgba(62, 175, 124, .10);
  --wbCardShadow: 0 6px 20px rgba(0, 0, 0, .05);
}
.theme-mode-dark {
  --bodyBg: #1d1d25;
  --mainBg: #252530;
  --borderColor: rgba(255, 255, 255, .12);
  --wbAccent: #5ec2a0;
  --wbAccentSoft: rgba(94, 194, 160, .12);
  --wbCardShadow: 0 6px 20px rgba(0, 0, 0, .22);
}
.theme-mode-read {
  --wbAccent: #8a6d3b;
  --wbAccentSoft: rgba(138, 109, 59, .10);
  --wbCardShadow: 0 6px 20px rgba(0, 0, 0, .06);
}

/* ---------- 2. 卡片：去浮起阴影，改细描边 ---------- */
.card-box {
  border: 1px solid var(--borderColor);
  border-radius: 12px;
  background: var(--mainBg);
  box-shadow: none !important;
  transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
}
.card-box:hover {
  border-color: var(--wbAccent);
  transform: translateY(-2px);
  box-shadow: var(--wbCardShadow) !important;
}

/* 圆角收敛：原先 0.2 / 0.4 / 2rem / 5px 四种混用 */
.custom-block.tip,
.custom-block.warning,
.custom-block.danger,
.custom-block.note,
.custom-block.details,
blockquote {
  border-radius: 8px;
}
mark {
  border-radius: 4px;
}

/* 移除深色模式里按钮的紫色荧光，换成统一强调色 */
.buttons .button:hover {
  background: var(--wbAccentSoft) !important;
  color: var(--wbAccent) !important;
  box-shadow: none !important;
}

/* 正文里的宽图不再溢出内容栏 */
.theme-vdoing-content img {
  max-width: 100%;
  height: auto;
}

/* ---------- 3. 动效 ---------- */
@keyframes wbFadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: none; }
}
@keyframes wbFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.theme-container,
.theme-vdoing-content {
  animation: wbFadeUp .45s ease-out both;
}

/* 列表交错出现，只动 opacity，避免与卡片 hover 的 transform 冲突 */
.post-list .post,
.archives-page .theme-vdoing-wrapper li,
.categories-wrapper .categories a,
.tags-wrapper a {
  animation: wbFadeIn .4s ease-out both;
}
.post-list .post:nth-child(1) { animation-delay: .04s; }
.post-list .post:nth-child(2) { animation-delay: .08s; }
.post-list .post:nth-child(3) { animation-delay: .12s; }
.post-list .post:nth-child(4) { animation-delay: .16s; }
.post-list .post:nth-child(5) { animation-delay: .20s; }
.post-list .post:nth-child(n+6) { animation-delay: .24s; }

.buttons .button,
.sidebar-button,
.pagination span {
  transition: transform .2s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
}
.buttons .button:hover,
.pagination span:hover {
  transform: translateY(-2px);
}

.search-box input {
  transition: width .25s ease, border-color .25s ease, background-color .25s ease;
}

/* ============================================================
   导航栏（2026-11-12 重做）
   实测依据，不是拍脑袋：
   1) 主题在 Navbar.vue 里给 .links 加了内联 max-width = 视口宽 − 站点名宽，
      意图是把菜单盒子卡在站点名右侧。但菜单内容比盒子宽时会向左溢出，
      直接压在站点名文字上（1440 宽实测「随笔」叠在「百里登风的博客」上）。
   2) 主题的 .navbar .links{position:absolute} 与 .search-box input{width:10rem}
      来自组件自身的 <style> 块，运行时注入，顺序在本文件之后；
      同级特异性下「后出现者胜」，普通规则会被盖掉 —— 所以关键属性一律 !important。
   3) 导航 13 个一级项自然宽约 1095px，加站点名、搜索与间距后整条约需 1530px，
      1440 视口根本放不下。收紧字号与内边距、并把搜索收成图标（聚焦再展开），
      整条降到约 1280px，1366 及以上可完整放下，不需要裁剪（裁剪会连带切掉下拉菜单）。
   ============================================================ */
$wbNavDesktopMin = 1361px
$wbNavMobileMax = 1360px

/* ---------- 4a. 宽屏：flex 重排，搜索固定最右 ---------- */
@media (min-width: $wbNavDesktopMin) {
  .navbar {
    display: flex !important;
    align-items: center !important;
  }
  .navbar .home-link {
    flex: 0 0 auto !important;
    margin-right: 16px !important;
    white-space: nowrap !important;
  }
  .navbar .site-name {
    flex: 0 0 auto !important;
    white-space: nowrap !important;
  }
  .navbar .links {
    position: static !important;
    right: auto !important;
    top: auto !important;
    flex: 1 1 auto !important;
    min-width: 0 !important;
    max-width: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    padding-left: 0 !important;
  }
  .navbar .links > .nav-links {
    order: 1 !important;
    flex: 0 1 auto !important;
    min-width: 0 !important;
    font-size: .8rem !important;
  }
  .navbar .links > .search-box {
    order: 2 !important;
    flex: 0 0 auto !important;
    margin-left: 12px !important;
    margin-right: 0 !important;
    position: relative !important;
  }
  /* 搜索收成图标；聚焦时向左展开覆盖在菜单之上，不挤压菜单导致溢出压字 */
  .navbar .links > .search-box input {
    width: 0 !important;
    padding: 0 .5rem 0 2rem !important;
    border-color: transparent !important;
    cursor: pointer !important;
    background-color: transparent !important;
  }
  .navbar .links > .search-box input:focus {
    width: 10rem !important;
    cursor: text !important;
    border-color: var(--borderColor, #ccc) !important;
    position: absolute !important;
    right: 0 !important;
    top: 0 !important;
    z-index: 30 !important;
    background-color: var(--mainBg) !important;
  }
  .navbar .nav-links .nav-item > a,
  .navbar .nav-links .dropdown-title {
    padding-left: .26rem !important;
    padding-right: .26rem !important;
  }
  /* 主题默认 .nav-item{margin-left:1.5rem}，13 个一级菜单之间光间距就占 288px，
     这是 1366 这类笔记本宽度放不下完整菜单的主因。收到 .65rem 后省出约 163px，
     1366 及以上可完整显示全部一级菜单与搜索图标，无需裁剪。 */
  .navbar .links > .nav-links .nav-item {
    margin-left: .65rem !important;
  }
  .navbar .links > .nav-links .nav-item:first-child {
    margin-left: 0 !important;
  }
  /* 当前导航项用滑动下划线，替掉生硬的 border-bottom */
  .navbar .nav-links .nav-item > a:not(.external) {
    position: relative;
    border-bottom: none !important;
  }
  .navbar .nav-links .nav-item > a:not(.external)::after {
    content: '';
    position: absolute;
    left: .26rem;
    right: .26rem;
    bottom: -2px;
    height: 2px;
    background: var(--wbAccent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform .25s ease;
  }
  .navbar .nav-links .nav-item > a.router-link-active::after,
  .navbar .nav-links .nav-item > a:not(.external):hover::after {
    transform: scaleX(1);
  }
  .wb-nav-drawer,
  .wb-nav-drawer-mask {
    display: none !important;
  }
}

/* ---------- 4b. 窄屏：顶部菜单收进抽屉，左上按钮真正可用 ---------- */
@media (max-width: $wbNavMobileMax) {
  .navbar {
    padding-left: 4rem !important;
  }
  .navbar .site-name {
    display: inline-block !important;
    width: auto !important;
    max-width: calc(100vw - 12rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .navbar .links {
    position: absolute !important;
    right: 1.5rem !important;
    top: .7rem !important;
    padding-left: 0 !important;
  }
  .navbar .links > .nav-links {
    display: none !important;
  }
  .navbar .links > .search-box {
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
  /* 左上角按钮：主题只在 ≤719px 显示，这里放宽到整个窄屏区间。
     点击行为由 enhanceApp.js 决定：有侧栏的页面交给主题，无侧栏的首页打开导航抽屉。 */
  .sidebar-button {
    display: block !important;
    position: fixed !important;
    top: .7rem !important;
    left: 1rem !important;
    width: 2rem !important;
    height: 2rem !important;
    margin: 0 !important;
    padding: .4rem !important;
    line-height: normal !important;
    text-align: center !important;
    border-radius: 8px !important;
    color: var(--textColor) !important;
    background: transparent !important;
    z-index: 60 !important;
  }
  .sidebar-button .icon {
    display: block !important;
    width: 1.2rem !important;
    height: 1.2rem !important;
  }
  .sidebar-button:hover {
    background: var(--wbAccentSoft) !important;
    color: var(--wbAccent) !important;
    box-shadow: none !important;
  }
  /* 主题自带的蒙版交给抽屉统一接管，避免出现「点了只有一层灰」 */
  .sidebar-mask {
    display: none !important;
  }
}

/* 抽屉容器 */
.wb-nav-drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, .38);
  z-index: 90;
  opacity: 0;
  visibility: hidden;
  transition: opacity .25s ease, visibility .25s ease;
}
body.wb-drawer-open .wb-nav-drawer-mask {
  opacity: 1;
  visibility: visible;
}
.wb-nav-drawer {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 320px;
  max-width: 84vw;
  background: var(--mainBg);
  color: var(--textColor);
  border-right: 1px solid var(--borderColor);
  z-index: 100;
  overflow-y: auto;
  transform: translateX(-100%);
  transition: transform .28s ease;
  padding: 16px 0 32px;
  box-sizing: border-box;
}
body.wb-drawer-open .wb-nav-drawer {
  transform: translateX(0);
}
.wb-nav-drawer-head {
  padding: 8px 20px 16px;
  font-size: 15px;
  font-weight: 500;
  border-bottom: 1px solid var(--borderColor);
  margin-bottom: 8px;
}
.wb-nav-drawer .nav-links {
  display: block !important;
  font-size: .95rem;
}
/* 抽屉里的菜单必须竖排。
   主题有 `.nav-links .nav-item{display:inline-block;margin-left:1.5rem}`，
   与本组选择器同特异性、但主题组件的 <style> 运行时注入在用户样式之后，
   同级下后写者胜 —— 不加 !important 的话抽屉会退化成横向内联排布，
   一行塞不下就换行、超出 315px 的部分被 overflow 裁掉。 */
.wb-nav-drawer .nav-item,
.wb-nav-drawer .dropdown-wrapper {
  display: block !important;
  float: none !important;
  width: 100% !important;
  height: auto !important;
  line-height: 1.5 !important;
  margin-left: 0 !important;
  position: static !important;
}
/* 「查看源码」在主题里是裸 <a class="repo-link">，同样要归零外边距占满整行 */
.wb-nav-drawer .repo-link {
  display: block !important;
  margin-left: 0 !important;
  padding: 10px 20px !important;
  color: var(--textColor) !important;
  border-bottom: 1px solid var(--borderColor);
}
.wb-nav-drawer .repo-link:hover {
  color: var(--wbAccent) !important;
  background: var(--wbAccentSoft);
}
/* vdoing 的下拉标题是 <button class="dropdown-title">：
   主题有同特异性的 .dropdown-wrapper .dropdown-title（后注入）会压掉这里的
   padding，浏览器又给 button 默认居中文本和边框 —— 全部加 !important 顶回去。 */
.wb-nav-drawer .nav-item > a,
.wb-nav-drawer .dropdown-title {
  display: block !important;
  width: 100% !important;
  box-sizing: border-box !important;
  padding: 10px 20px !important;
  margin: 0 !important;
  color: var(--textColor) !important;
  background: transparent !important;
  border: none !important;
  border-bottom: 1px solid var(--borderColor) !important;
  text-align: left !important;
  font-size: inherit !important;
  cursor: pointer !important;
  line-height: 1.5 !important;
}
/* 「索引」这类同时带 link 的下拉，标题按钮里内嵌了一个 <a class="link-title">。
   它必须保持内联跟箭头同行 —— 若被块级化会从按钮里挤出第二行「索引」。
   这里显式清掉内边距和边框，颜色随按钮走。 */
.wb-nav-drawer .dropdown-title a {
  display: inline !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  color: inherit !important;
  font-size: inherit !important;
  font-weight: inherit !important;
  text-decoration: none !important;
}
/* 按钮「link-title + title」双标题并存时，文本版是主题留作备用的隐藏元素；
   但主题有 .dropdown-wrapper .dropdown-title .title{display:inline-block!important}
   会把内联 display:none 顶回来，造成「索引 索引」重复。
   特异性必须压过主题这条（0,4,0 → 0,5,0），否则注入顺序也救不了。 */
.wb-nav-drawer .nav-links .dropdown-title .link-title ~ .title {
  display: none !important;
}
.wb-nav-drawer .dropdown-title {
  position: relative !important;
}
.wb-nav-drawer .nav-item > a:hover,
.wb-nav-drawer .dropdown-title:hover {
  color: var(--wbAccent) !important;
  background: var(--wbAccentSoft) !important;
}
/* 下拉箭头贴到行右端，不挤在文字后面 */
.wb-nav-drawer .dropdown-title .arrow {
  position: absolute !important;
  right: 20px !important;
  top: 50% !important;
  margin-left: 0 !important;
  transform: translateY(-50%) !important;
}
.wb-nav-drawer .dropdown-wrapper.wb-open .dropdown-title .arrow {
  transform: translateY(-50%) rotate(180deg) !important;
}
.wb-nav-drawer .dropdown-wrapper:not(.wb-open) .nav-dropdown {
  display: none !important;
}
.wb-nav-drawer .dropdown-wrapper.wb-open .nav-dropdown {
  display: block !important;
  position: static;
  box-shadow: none;
  border: none;
  background: transparent;
  padding: 0 0 8px 12px;
}
.wb-nav-drawer .nav-dropdown .dropdown-item {
  line-height: 1.5;
}
.wb-nav-drawer .wb-drawer-toc {
  padding: 8px 20px 0;
}
.wb-nav-drawer .wb-drawer-toc-title {
  font-size: 13px;
  color: var(--wbAccent);
  padding: 16px 0 8px;
  border-bottom: 1px solid var(--borderColor);
}
.wb-nav-drawer .sidebar-links {
  padding-left: 12px;
}
.wb-nav-drawer .sidebar-links a {
  display: block;
  padding: 6px 0;
  color: var(--textColor);
}

/* ---------- 6. 无障碍：尊重系统减少动效偏好 ---------- */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
