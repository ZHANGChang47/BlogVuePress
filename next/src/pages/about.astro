---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sections = new Set(posts.map((p) => p.data.section)).size;
const words = posts.reduce((s, p) => s + p.data.words, 0);
---
<BaseLayout title="关于">
  <div class="page-head">
    <div class="eyebrow">About / This Site</div>
    <h1>关于这个站</h1>
    <p>张弓折扇风雨历，畅叙平生快意！—— 这句原本就是站点的描述，现在也成了首页的标题。</p>
  </div>

  <div class="stack" style="margin-top:48px">
    <section>
      <div class="grid-2">
        <div class="panel">
          <h3>这里有什么</h3>
          <p>{posts.length} 篇技术笔记与随笔，分布在 {sections} 个分区，正文约 {(words / 10000).toFixed(1)} 万字。内容以 Java 基础、JavaWeb、Spring 生态、前端、算法为主，另有散文随笔与项目记录。这批笔记归档于 2023 年，日期是原站导入标记，不是写作时间。</p>
        </div>
        <div class="panel">
          <h3>重写改了什么</h3>
          <p>技术栈从 VuePress 1.x（Vue 2.7 + webpack 4）换成 Astro 静态构建；首页重新编排为「流光·曦」，浅色为默认主题、可一键切换深色；补上正文全文搜索、标签、前后篇导航与代码增强；另外单独留了一页放自己写的小工具。</p>
        </div>
      </div>
    </section>

    <section>
      <div class="sec-head"><div><div class="eyebrow">Guarantees</div><h2>三条没让步的地方</h2></div></div>
      <div class="grid-2">
        <div class="panel">
          <h3>永久链接未变</h3>
          <p>每篇文章的永久链接都与旧站 76 条线上地址逐条比对，缺失 0、多出 0。搜索引擎收录与外链不会因为改版失效。</p>
        </div>
        <div class="panel">
          <h3>数据与正文不造假</h3>
          <p>正文一字未改；日期保留原值且明确标注为导入标记；标签按公开关键词规则生成并说明来源；没有命中规则的文章如实标为「未标注」。</p>
        </div>
        <div class="panel">
          <h3>长文可读性优先</h3>
          <p>玻璃拟态只用于首页与导航。文章正文用不透明底色承载，不叠模糊层；代码块保留折叠与复制；深浅两套主题都保证正文对比度。</p>
        </div>
        <div class="panel">
          <h3>零运维</h3>
          <p>纯静态站点，无需后端、无需登录、也不依赖外部搜索服务；小工具以独立页面呈现，不引入数据库。</p>
        </div>
      </div>
    </section>

    <section>
      <div class="sec-head"><div><div class="eyebrow">Links</div><h2>链接</h2></div></div>
      <div class="tag-cloud">
        <a class="chip" href="https://github.com/ZHANGChang47/BlogVuePress" rel="noopener noreferrer">GitHub 仓库 ↗</a>
        <a class="chip" href={`${import.meta.env.BASE_URL}rss.xml`}>RSS 订阅</a>
        <a class="chip" href={`${import.meta.env.BASE_URL}tools/`}>我的工具</a>
        <a class="chip" href={`${import.meta.env.BASE_URL}categories/`}>全部分类</a>
      </div>
    </section>
  </div>
</BaseLayout>
